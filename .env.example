# Copy to .env and fill in. All values are required — the app will not start without them.
BML_API_KEY=
PABBLY_USERNAME=
PABBLY_PASSWORD=

# Public URL of this app, no trailing slash. Used to build BML's return URL.
DOMAIN=https://pay.example.com

# Where customers land when a product has no redirect configured.
DEFAULT_REDIRECT_URL=https://example.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
